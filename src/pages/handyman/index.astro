---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhoneCTA from '../../components/PhoneCTA.astro';
import { siteConfig } from '../../config';

const { businessName, phone, phoneE164, siteUrl, serviceKeyword, serviceKeywordPlural, city, region, services, cities } = siteConfig;

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Handyman",
  "provider": {
    "@type": "LocalBusiness",
    "name": businessName,
    "telephone": phoneE164,
  },
  "areaServed": { "@type": "State", "name": "Kentucky" },
  "description": `Professional handyman services for residential and commercial properties in ${city}.`,
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": `${siteUrl}/handyman/` },
  ],
};
---

<BaseLayout
  title={`Handyman Services ${city} | ${businessName}`}
  description={`Handyman services in ${city}. We provide home repairs, fixture installations, and honey-do list services across ${region}. Call ${phone} for a free estimate.`}
  canonicalURL={`${siteUrl}/handyman/`}
  schema={[breadcrumbSchema, serviceSchema]}
>

<!-- Hero -->
<section class="hero-section">
  <div class="container">
    <h1>Handyman Services in {city}</h1>
    <p class="hero-sub">Home repairs, fixture installations, and more. Serving all of {region}.</p>
    <PhoneCTA />
  </div>
</section>

<!-- Photo -->
<div class="container py-6 text-center">
  <img
    src="/photos/hero.jpg"
    alt={`Handyman services in ${city}`}
    class="site-photo mx-auto max-w-2xl"
    loading="eager"
  />
</div>

<!-- Services -->
<div class="content-section">
  <h2 class="text-brand text-xl md:text-2xl font-bold mb-4">Our Handyman Services</h2>

  <p>{businessName} provides professional handyman services throughout {city}. We handle home repairs, fixture installations, and maintenance for homes and businesses. No job is too small. Here are the services we offer:</p>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5 my-8">
    {services.map((service) => (
      <div class="service-card">
        <img src={service.photo} alt={`${service.title} — ${businessName}`} loading="lazy" />
        <div class="card-body">
          <h3>{service.title}</h3>
          <p>{service.description}</p>
        </div>
      </div>
    ))}
  </div>

  <h2 class="text-brand text-xl md:text-2xl font-bold mb-4 mt-8">How Our Handyman Service Works</h2>

  <p>Getting help from {businessName} is easy. Here's how it works:</p>

  <p><strong>Step 1: Call Us.</strong> Give us a call at {phone} and tell us about the work you need done. We'll listen to what's on your list and ask any clarifying questions.</p>

  <p><strong>Step 2: Get Your Free Estimate.</strong> We'll give you a clear, upfront price for the work. No hidden fees, no surprises. For most jobs, we can give you a ballpark estimate over the phone.</p>

  <p><strong>Step 3: We Do the Work.</strong> Our team arrives on time with all the tools and supplies needed. We work efficiently, treat your home with respect, and clean up when we're done.</p>

  <p><strong>Step 4: Enjoy Your Home.</strong> Your repairs are done, your fixtures are installed, and your to-do list is cleared. Not happy with something? We'll make it right. That's our satisfaction guarantee.</p>

  <h2 class="text-brand text-xl md:text-2xl font-bold mb-4 mt-8">Handyman Service Areas</h2>

  <p>We provide handyman services across {city}. We serve:</p>

  <ul>
    {cities.map((c) => (
      <li><a href={`/handyman/${c.slug}/`}>Handyman in {c.name}</a></li>
    ))}
  </ul>
</div>

<!-- CTA -->
<section class="bg-gray-50 border-y-2 border-brand">
  <div class="cta-strip container">
    <p class="cta-heading">Ready to Cross Items Off Your List?</p>
    <p class="cta-sub">Call now for a free handyman estimate in {city}.</p>
    <PhoneCTA />
  </div>
</section>

<!-- Final CTA -->
<section class="bg-brand-dark text-white">
  <div class="cta-strip container">
    <h2 class="text-white text-xl md:text-2xl font-bold mb-2">Call Now for Handyman Services in {city}</h2>
    <p class="text-white/90 text-base mb-4">We provide handyman services across {region}.</p>
    <PhoneCTA label="Call Now" />
  </div>
</section>

</BaseLayout>
