---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhoneCTA from '../components/PhoneCTA.astro';
import { siteConfig } from '../config';

const { businessName, phone, siteUrl, city, region, cities, services } = siteConfig;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "About Us", "item": `${siteUrl}/about/` },
  ],
};

const aboutPageSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": `About ${businessName}`,
  "description": `${businessName} provides home repairs, fixture installation, and honey-do list services in ${city}.`,
  "mainEntity": {
    "@type": "LocalBusiness",
    "name": businessName,
    "telephone": siteConfig.phoneE164,
  },
};
---

<BaseLayout
  title={`About Us | ${businessName}`}
  description={`${businessName} handles home repairs, fixture installations, and honey-do lists in Florence, Covington, Fort Thomas, Newport, and across ${region}. Free estimates.`}
  canonicalURL={`${siteUrl}/about/`}
  schema={[breadcrumbSchema, aboutPageSchema]}
>

<!-- Hero -->
<section class="hero-section">
  <div class="container">
    <h1>About {businessName}</h1>
    <p class="hero-sub">Handyman services for Northern Kentucky homes and businesses.</p>
    <PhoneCTA />
  </div>
</section>

<!-- Photo -->
<div class="container py-6 text-center">
  <img
    src="/photos/team.jpg"
    alt={`${businessName} team`}
    class="site-photo mx-auto max-w-2xl"
    loading="eager"
  />
</div>

<!-- About content -->
<div class="content-section">
  <h2 class="text-brand text-xl md:text-2xl font-bold mb-4">What We Do</h2>

  <p>{businessName} handles the small and mid-sized jobs around the house that are hard to find someone for: drywall patches, sticking doors, trim and caulking, fixture swaps, TV mounts, shelving, and the rest of the to-do list. We work for homeowners, landlords, and small businesses across {region}.</p>

  <ul>
    {services.map((s) => (
      <li><strong>{s.title}</strong> — {s.description}</li>
    ))}
  </ul>

  <img
    src="/photos/residential.jpg"
    alt={`Handyman services in ${city}`}
    class="site-photo mx-auto max-w-lg my-6"
    loading="lazy"
  />

  <h2 class="text-brand text-xl md:text-2xl font-bold mb-4 mt-8">How a Job Works</h2>

  <p><strong>1. Call.</strong> Call {phone} or send the form with your list. For most jobs we can give you a ballpark price over the phone; larger jobs get a free in-home estimate.</p>

  <p><strong>2. Schedule.</strong> We can usually schedule within two to three days. Let us know which fixtures or materials you already have, and we'll bring basic supplies.</p>

  <p><strong>3. Work and walk-through.</strong> We work through the list, clean up, and go over the finished work with you before we leave. If a job needs a permit or a licensed electrician or plumber, we'll tell you up front.</p>

  <h2 class="text-brand text-xl md:text-2xl font-bold mb-4 mt-8">Where We Work</h2>

  <p>Our main service areas in Boone, Kenton, and Campbell counties:</p>

  <ul>
    {cities.map((c) => (
      <li><a href={`/handyman/${c.slug}/`}>Handyman in {c.name}</a></li>
    ))}
  </ul>

  <p>Close by but not on the list? Call {phone} and ask.</p>
</div>

<!-- CTA -->
<section class="bg-gray-50 border-y-2 border-brand">
  <div class="cta-strip container">
    <p class="cta-heading">Ready to Cross Items Off Your To-Do List?</p>
    <p class="cta-sub">Call now for a free estimate.</p>
    <PhoneCTA />
  </div>
</section>

</BaseLayout>
